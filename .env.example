# Vite (website). Copy to .env.local for local overrides; on Vercel set it in Project Settings > Environment Variables.
# URL of the deployed code runner (Render). Leave empty to disable Java on the deployed site.
VITE_API_URL=

# Code runner (server/index.js). Set these in the Render dashboard.
# NODE_ENV=production
# ALLOWED_ORIGINS=https://your-site.vercel.app
# RUNNER_LANGUAGES=java
# MAX_CONCURRENT=2
# RATE_PER_MIN=20
